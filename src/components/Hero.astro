---
/**
 * Hero - Full redesign
 * 
 * Minimal, technical, role-driven landing with point-cloud morphing.
 */

interface RoleContent {
  label: string;
  title: string;
  subtitle: string;
  description: string;
  highlights: string[];
}

const roleContent: Record<string, RoleContent> = {
  home: {
    label: 'Home',
    title: 'Praveen Venkatesh',
    subtitle: 'I build research that ships at scale.',
    description: 'Mach9: ML for Digital Surveyor, sub-centimeter 3D across 20,000+ miles. CMU Robotics alum; IIT Gandhinagar Rank 1.',
    highlights: ['Mach9', 'CMU Robotics', 'IIT'],
  },
  engineer: {
    label: 'Builder',
    title: 'Builder',
    subtitle: 'Mapping · Calibration · Inference',
    description: 'I ship LiDAR-vision pipelines and production ML infrastructure for city-scale mapping.',
    highlights: ['HD mapping systems', 'Self-supervised calibration', 'Real-time inference'],
  },
  explorer: {
    label: 'Explorer',
    title: 'Explorer',
    subtitle: 'Ventures · Research · Field Work',
    description: 'I move from theory to terrain: new ventures, research arcs, and real-world deployments.',
    highlights: ['Aurum (AI finance)', 'MITACS Globalink', 'Founder/Builder'],
  },
  artist: {
    label: 'Artist',
    title: 'Artist',
    subtitle: 'Writing · Teaching · Craft',
    description: 'I translate complexity into clarity through writing, mentoring, and creative systems.',
    highlights: ['41K+ readers', 'Teaching assistantships', 'Creative tooling'],
  },
};
---

<section class="hero" id="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <h1 class="hero-title" id="hero-title">{roleContent.home.title}</h1>
      <p class="hero-subtitle" id="hero-subtitle">{roleContent.home.subtitle}</p>
      <div class="hero-highlights" id="hero-highlights">
        {roleContent.home.highlights.map(item => (
          <span class="hero-chip">{item}</span>
        ))}
      </div>

      <div class="hero-actions">
        <a class="hero-link" href="/engineer">Builder Work</a>
        <a class="hero-link" href="/explorer">Ventures</a>
        <a class="hero-link" href="/artist">Writing</a>
      </div>
      <p class="hero-footnote">
        If it doesn't ship, it doesn't count.
      </p>
    </div>
  </div>

  <div class="hero-hint">
    <span>move to interact</span>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding: 6rem 2rem 4rem;
  }

  .hero-inner {
    max-width: 960px;
    width: 100%;
    margin: 0 auto;
    position: relative;
    z-index: 10;
  }

  .hero-title {
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .hero-subtitle {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--mode-color);
    margin-bottom: 1.25rem;
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.75rem 0 2.5rem;
  }

  .hero-chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.02);
    color: var(--color-text-secondary);
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-footnote {
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .hero-footnote a {
    color: var(--color-text-secondary);
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .hero-footnote a:hover {
    color: var(--mode-color);
    border-color: var(--mode-color);
  }

  .hero-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-secondary);
    border-bottom: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .hero-link:hover {
    color: var(--mode-color);
    border-color: var(--mode-color);
  }

  .hero-hint {
    position: absolute;
    right: 2rem;
    bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 5rem 1.5rem 3rem;
    }

    .hero-hint {
      display: none;
    }
  }
</style>
