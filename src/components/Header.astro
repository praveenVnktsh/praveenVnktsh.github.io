---
const navLinks = [
  { label: 'Builder', href: '/engineer' },
  { label: 'Explorer', href: '/explorer' },
  { label: 'Artist', href: '/artist' },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-4 left-1/2 -translate-x-1/2 z-50 header-pill">
  <nav class="flex items-center justify-center h-12 px-4">
    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-6">
      <div class="nav-tabs" role="tablist" aria-label="Primary">
        <a
          href="/"
          class:list={[
            'nav-tab',
            currentPath === '/' && 'active',
          ]}
        >
          Home
        </a>
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={[
              'nav-tab',
              currentPath === link.href && 'active',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Theme Toggle & Mobile Menu -->
    <div class="flex items-center gap-4 md:absolute md:right-4">
      <button
        id="mobile-menu-toggle"
        class="md:hidden p-2 rounded-lg bg-[var(--color-bg-secondary)] hover:bg-[var(--color-bg-tertiary)] transition-colors"
        aria-label="Toggle menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="fixed inset-0 z-40 bg-[var(--color-bg-primary)]/75 backdrop-blur-xl hidden md:hidden">
    <div class="container pt-20 pb-6">
      <button
        id="mobile-menu-close"
        class="absolute top-4 right-4 p-2 rounded-lg bg-[var(--color-bg-secondary)] hover:bg-[var(--color-bg-tertiary)] transition-colors"
        aria-label="Close menu"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <nav class="flex flex-col gap-4">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="text-lg text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors mobile-nav-link"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<style>
  .header-pill {
    background: rgba(10, 10, 16, 0.7);
    border: 1px solid color-mix(in srgb, var(--color-border) 70%, transparent);
    border-radius: 999px;
    backdrop-filter: blur(14px);
    box-shadow: 0 14px 30px -22px rgba(0, 0, 0, 0.7);
  }

  .nav-tabs {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.35rem;
    border-radius: 999px;
    border: none;
    background: transparent;
    box-shadow: none;
  }

  .nav-tab {
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .nav-tab:hover {
    color: var(--color-text-primary);
  }

  .nav-tab.active {
    color: var(--color-text-primary);
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 16px rgba(255, 255, 255, 0.08);
  }
</style>

<script>
  // Mobile Menu
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.remove('hidden');
  });

  mobileMenuClose?.addEventListener('click', () => {
    mobileMenu?.classList.add('hidden');
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
