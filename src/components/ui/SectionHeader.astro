---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'center' } = Astro.props;
---

<div class:list={[
  'section-header-reveal mb-12',
  align === 'center' ? 'text-center' : 'text-left'
]}>
  <h2 class="section-title text-3xl md:text-4xl font-bold mb-4" style="opacity: 0;">
    <span class="gradient-text">{title}</span>
  </h2>
  {subtitle && (
    <p class:list={[
      'section-subtitle text-lg text-[var(--color-text-secondary)]',
      align === 'center' && 'max-w-2xl mx-auto'
    ]} style="opacity: 0;">
      {subtitle}
    </p>
  )}
</div>
