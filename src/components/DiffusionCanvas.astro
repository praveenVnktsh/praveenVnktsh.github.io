---
/**
 * Full-screen point cloud canvas backdrop.
 */
---

<canvas id="pointcloud-canvas" class="pointcloud-canvas"></canvas>

<style>
  .pointcloud-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
  }
</style>

<script>
  import {
    initPointCloud,
    setRole,
    type Role,
  } from '../scripts/pointcloud-morph';

  // Import PLY files
  import heroPlyUrl from '../../pcds/hero.ply?url';
  import rubiksPlyUrl from '../../pcds/rubiks.ply?url';

  const canvas = document.getElementById(
    'pointcloud-canvas',
  ) as HTMLCanvasElement;

  if (canvas) {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    if (!prefersReducedMotion) {
      initPointCloud(canvas, {
        plyUrls: {
          home: heroPlyUrl,
          engineer: rubiksPlyUrl,
        },
      }).then(() => {
        const initialMode = (document.body.getAttribute('data-mode') || 'home') as Role;
        const cloudSide = initialMode === 'explorer' ? 'left' : 'right';
        setRole(initialMode, cloudSide);

        (window as any).setPointCloudRole = setRole;
      });
    }
  }
</script>
