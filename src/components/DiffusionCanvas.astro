---
/**
 * Full-screen point cloud canvas with slideshow navigation.
 * Scroll/swipe moves to next/previous page entirely.
 */
---

<canvas id="pointcloud-canvas" class="pointcloud-canvas"></canvas>

<style>
  .pointcloud-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 1;
  }
</style>

<script>
  import {
    initPointCloud,
    setRole,
    type Role,
  } from '../scripts/pointcloud-morph';

  // Import PLY files
  import heroPlyUrl from '../../pcds/hero.ply?url';
  import rubiksPlyUrl from '../../pcds/rubiks.ply?url';

  const canvas = document.getElementById(
    'pointcloud-canvas',
  ) as HTMLCanvasElement;

  if (canvas) {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches;

    if (!prefersReducedMotion) {
      initPointCloud(canvas, {
        plyUrls: {
          home: heroPlyUrl,
          engineer: rubiksPlyUrl,
        },
      }).then(() => {
        // Section config
        const sections: Array<{ id: string; role: Role; cloudSide: 'left' | 'right' }> = [
          { id: 'hero', role: 'home', cloudSide: 'right' },
          { id: 'engineer', role: 'engineer', cloudSide: 'right' },
          { id: 'explorer', role: 'explorer', cloudSide: 'left' },
          { id: 'artist', role: 'artist', cloudSide: 'right' },
        ];

        let currentIndex = 0;
        let isNavigating = false;
        const COOLDOWN_MS = 1500; // Allow time for gentle gravitational drift

        // Navigate to a specific section
        const goToSection = (index: number) => {
          if (index < 0 || index >= sections.length) return;
          if (isNavigating) return;

          const section = sections[index];
          const el = document.getElementById(section.id);
          if (!el) return;

          isNavigating = true;
          currentIndex = index;

          // Set new role and cloud side - offset is baked into targets
          // so each particle drifts individually to its new position
          setRole(section.role, section.cloudSide);
          document.body.setAttribute('data-mode', section.role);

          // Scroll to section
          el.scrollIntoView({ behavior: 'smooth' });

          // Cooldown before next navigation
          setTimeout(() => {
            isNavigating = false;
          }, COOLDOWN_MS);
        };

        const goNext = () => goToSection(currentIndex + 1);
        const goPrev = () => goToSection(currentIndex - 1);

        // Intercept wheel events for slideshow navigation
        let wheelAccumulator = 0;
        const WHEEL_THRESHOLD = 50;

        window.addEventListener('wheel', (e) => {
          e.preventDefault();
          
          if (isNavigating) return;

          wheelAccumulator += e.deltaY;

          if (wheelAccumulator > WHEEL_THRESHOLD) {
            wheelAccumulator = 0;
            goNext();
          } else if (wheelAccumulator < -WHEEL_THRESHOLD) {
            wheelAccumulator = 0;
            goPrev();
          }
        }, { passive: false });

        // Touch swipe for mobile
        let touchStartY = 0;
        let touchStartX = 0;
        const SWIPE_THRESHOLD = 50;

        window.addEventListener('touchstart', (e) => {
          touchStartY = e.touches[0].clientY;
          touchStartX = e.touches[0].clientX;
        }, { passive: true });

        window.addEventListener('touchend', (e) => {
          if (isNavigating) return;

          const touchEndY = e.changedTouches[0].clientY;
          const touchEndX = e.changedTouches[0].clientX;
          const deltaY = touchStartY - touchEndY;
          const deltaX = touchStartX - touchEndX;

          // Only navigate if vertical swipe is dominant
          if (Math.abs(deltaY) > Math.abs(deltaX) && Math.abs(deltaY) > SWIPE_THRESHOLD) {
            if (deltaY > 0) {
              goNext();
            } else {
              goPrev();
            }
          }
        }, { passive: true });

        // Keyboard navigation
        window.addEventListener('keydown', (e) => {
          if (isNavigating) return;

          if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === ' ') {
            e.preventDefault();
            goNext();
          } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
            e.preventDefault();
            goPrev();
          } else if (e.key === 'Home') {
            e.preventDefault();
            goToSection(0);
          } else if (e.key === 'End') {
            e.preventDefault();
            goToSection(sections.length - 1);
          }
        });

        // Listen for role changes from Hero tabs
        window.addEventListener('setrole', ((e: CustomEvent<{ role: Role }>) => {
          const idx = sections.findIndex(s => s.role === e.detail.role);
          if (idx !== -1) goToSection(idx);
        }) as EventListener);

        // Expose for debugging
        (window as any).setPointCloudRole = setRole;
        (window as any).goToSection = goToSection;

        // Initial state
        setRole('home', 'right');
        document.body.setAttribute('data-mode', 'home');
      });
    }
  }
</script>
